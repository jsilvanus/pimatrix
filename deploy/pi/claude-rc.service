# Starts Claude Code remote control inside a screen session.
[Unit]
Description=Claude Code remote control (in screen session "claude")

[Service]
WorkingDirectory=%h/apps
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# The user manager cannot order after network-online.target, so wait for the API here.
ExecStartPre=/bin/sh -c 'until curl -s -o /dev/null --max-time 5 https://api.anthropic.com; do sleep 3; done'
ExecStart=/usr/bin/screen -DmS claude %h/.local/bin/claude rc --debug-file %h/apps/claude-rc.debug.log
Restart=always
RestartSec=15

[Install]
WantedBy=default.target
