# Copy to /home/pi/apps/pimatrix.env and edit. Replace every placeholder.
PIMATRIX_HOST=0.0.0.0
PIMATRIX_PORT=3000
PIMATRIX_MODE=production
PIMATRIX_DISPLAY_MODE=hardware
PIMATRIX_HDMI_PLAYER=/home/pi/apps/pimatrix/deploy/pi/pimatrix-player
PIMATRIX_HDMI0_DEVICE=HDMI-A-1
PIMATRIX_HDMI1_DEVICE=HDMI-A-2
PIMATRIX_MEDIAMTX_API_URL=http://127.0.0.1:9997
PIMATRIX_MEDIAMTX_RTSP_URL=rtsp://127.0.0.1:8554
PIMATRIX_PREVIEW_BASE_URL=http://kirkonpi.local:8889
PIMATRIX_HAMA_ENABLED=true
PIMATRIX_HAMA_DEVICE=/dev/video0
PIMATRIX_HAMA_INPUT_FORMAT=mjpeg
PIMATRIX_HAMA_WIDTH=1920
PIMATRIX_HAMA_HEIGHT=1080
PIMATRIX_HAMA_FRAME_RATE=30
PIMATRIX_HAMA_VIDEO_CODEC=libx264
PIMATRIX_HAMA_RTSP_URL=rtsp://127.0.0.1:8554/hama
# ATEM, cameras and the Atlona matrix live in pigateway (set their addresses and camera logins in its env file).
PIMATRIX_GATEWAY_URL=http://127.0.0.1:3100
# PIMATRIX_GATEWAY_API_KEY=
# The AMX connects to pigateway on 6600; video commands are forwarded to this listener.
PIMATRIX_AMX_TCP_PORT=6601
# Production mode refuses to start without PIMATRIX_API_KEY.
PIMATRIX_API_KEY=replace-with-a-long-random-key

# Slide composite HDMI key output (compose1). Pick the Pi connector wired to the Atlona input the ATEM reads.
# PIMATRIX_COMPOSITE_HDMI_DEVICE=HDMI-A-2
