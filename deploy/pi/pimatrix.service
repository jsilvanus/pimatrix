[Unit]
Description=PiMatrix API
After=mediamtx.service

[Service]
WorkingDirectory=%h/apps/pimatrix
EnvironmentFile=%h/apps/pimatrix.env
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/node packages/api/dist/main.js
Restart=on-failure

[Install]
WantedBy=default.target
