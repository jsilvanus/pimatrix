FROM node:22-alpine AS builder

WORKDIR /app

# pnpm 11 needs Node 22.13+; corepack reads the pinned version from package.json.
RUN corepack enable

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY openapi/ ./openapi/
COPY packages/api/package.json ./packages/api/
COPY packages/api-client/package.json ./packages/api-client/
COPY packages/cli/package.json ./packages/cli/

RUN pnpm install --frozen-lockfile

COPY packages/ ./packages/

RUN pnpm run build

FROM node:22-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV PIMATRIX_HOST=0.0.0.0
ENV PIMATRIX_PORT=3101

RUN corepack enable

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages/api/package.json ./packages/api/
COPY packages/api-client/package.json ./packages/api-client/
COPY packages/cli/package.json ./packages/cli/

RUN pnpm install --frozen-lockfile --prod

COPY --from=builder /app/packages/api/dist ./packages/api/dist
COPY --from=builder /app/packages/api-client/dist ./packages/api-client/dist
COPY --from=builder /app/packages/cli/dist ./packages/cli/dist
COPY --from=builder /app/openapi ./openapi

USER node

EXPOSE 3101
EXPOSE 6600

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:3101/health || exit 1

CMD ["node", "packages/api/dist/main.js"]
