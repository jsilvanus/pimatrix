# PiMatrix Configuration & Environment Variables

# ==========================================
# Server Runtime
# ==========================================
PIMATRIX_HOST=0.0.0.0
PIMATRIX_PORT=3000
PIMATRIX_MODE=simulation # "simulation" or "production"
PIMATRIX_DISPLAY_MODE=simulated # "simulated", "hardware", or "disabled"

# ==========================================
# Security & Access Control
# ==========================================
# API Key for mutating REST endpoints and Web UI access.
# When set, mutating API calls require 'Authorization: Bearer <token>' or '?key=<token>'.
# Web UI prompts for this password and stores it in localStorage.
PIMATRIX_API_KEY=change-me-secret-api-key

# Dedicated token for Canva app integration.
# When set, Canva control requests may authenticate with either PIMATRIX_CANVA_APP_TOKEN or PIMATRIX_API_KEY.
PIMATRIX_CANVA_APP_TOKEN=change-me-canva-app-token

# AMX NetLinx TCP Listener IP Whitelist.
# Comma-separated list of IPv4/IPv6 addresses allowed to connect to port 6600.
# Connections from any other IP are dropped immediately. Leave unset to permit all.
PIMATRIX_AMX_ALLOWED_HOSTS=127.0.0.1,192.168.1.50

# MediaMTX RTMP/RTSP ingest password / stream key.
# Shown in the Web UI modal for easy copy-pasting into OBS / Windows Companion / encoders.
PIMATRIX_MEDIAMTX_PASSWORD=stream-ingest-secret-key

# ==========================================
# MediaMTX Integration
# ==========================================
PIMATRIX_MEDIAMTX_API_URL=http://127.0.0.1:9997
PIMATRIX_PREVIEW_BASE_URL=http://127.0.0.1:8889

# ==========================================
# AMX NetLinx TCP Interface
# ==========================================
PIMATRIX_AMX_TCP_ENABLED=true
PIMATRIX_AMX_TCP_HOST=0.0.0.0
PIMATRIX_AMX_TCP_PORT=6600
PIMATRIX_AMX_SIMULATED=true
# PIMATRIX_AMX_MASTER_HOST=192.168.1.50
# PIMATRIX_AMX_MASTER_PORT=6501

# ==========================================
# Hama USB Capture Card (Raspberry Pi V4L2)
# ==========================================
PIMATRIX_HAMA_ENABLED=false
PIMATRIX_HAMA_DEVICE=/dev/video0
# PIMATRIX_HAMA_INPUT_FORMAT=mjpeg
# PIMATRIX_HAMA_WIDTH=1920
# PIMATRIX_HAMA_HEIGHT=1080
# PIMATRIX_HAMA_FRAME_RATE=60
# PIMATRIX_HAMA_VIDEO_CODEC=copy

# ==========================================
# PTZ Cameras
# ==========================================
PIMATRIX_CAMERA_MODE=simulated
PIMATRIX_CAM1_NAME=Camera 1
# PIMATRIX_CAM1_HOST=192.168.1.101
# PIMATRIX_CAM1_VISCA_PORT=52381
# PIMATRIX_CAM1_CGI_PORT=80
PIMATRIX_CAM2_NAME=Camera 2
# PIMATRIX_CAM2_HOST=192.168.1.102
# PIMATRIX_CAM2_VISCA_PORT=52381
# PIMATRIX_CAM2_CGI_PORT=80
