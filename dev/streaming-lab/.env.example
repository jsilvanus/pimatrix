# Copy these values into your local shell or .env used to launch PiMatrix.
# These addresses are for PiMatrix running directly on the Windows/WSL host.
PIMATRIX_HOST=127.0.0.1
PIMATRIX_PORT=3000
PIMATRIX_MODE=simulation
PIMATRIX_MEDIAMTX_API_URL=http://127.0.0.1:9997
PIMATRIX_PREVIEW_BASE_URL=http://127.0.0.1:8889

# Do not enable physical Hama capture in this simulated lab.
PIMATRIX_HAMA_ENABLED=false
