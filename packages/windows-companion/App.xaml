<Application x:Class="PiMatrixCompanion.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:common="clr-namespace:PiMatrixCompanion.Common"
             xmlns:models="clr-namespace:PiMatrixCompanion.Models">
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <common:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <common:BoolToColorConverter x:Key="BoolToColorConverter"/>
        <common:StreamButtonColorConverter x:Key="StreamButtonColorConverter"/>
        <common:StreamButtonTextConverter x:Key="StreamButtonTextConverter"/>

        <ObjectDataProvider x:Key="ProtocolEnumValues"
                            MethodName="GetValues"
                            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:ProtocolType"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <ObjectDataProvider x:Key="EncoderEnumValues"
                            MethodName="GetValues"
                            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:EncoderType"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Application.Resources>
</Application>
