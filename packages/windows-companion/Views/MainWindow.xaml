<Window x:Class="PiMatrixCompanion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PiMatrixCompanion.ViewModels"
        xmlns:models="clr-namespace:PiMatrixCompanion.Models"
        mc:Ignorable="d"
        Title="PiMatrix Virtual Displays Companion"
        Height="780" Width="1100"
        MinHeight="600" MinWidth="850"
        Background="#0F0F12"
        Foreground="#F4F4F5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP HEADER & PiMatrix STATUS -->
        <Border Grid.Row="0" Background="#18181B" BorderBrush="#27272A" BorderThickness="0,0,0,1" Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand & Logo -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#10B981" Width="28" Height="28" CornerRadius="6" Margin="0,0,12,0">
                        <TextBlock Text="π" FontSize="18" FontWeight="Bold" Foreground="#09090B"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="PiMatrix Companion" FontWeight="Bold" FontSize="16" Foreground="#FAFAFA"/>
                        <TextBlock Text="Virtual Display &amp; Low-Latency Ingestion Engine" FontSize="11" Foreground="#A1A1AA"/>
                    </StackPanel>
                </StackPanel>

                <!-- PiMatrix Target Connection Info -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="#27272A" CornerRadius="6" Padding="12,6" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Target: " Foreground="#71717A" FontSize="12"/>
                            <TextBox Text="{Binding PiMatrixHost, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" Foreground="#E4E4E7" BorderThickness="0"
                                     FontWeight="SemiBold" FontSize="12" Width="100"/>
                            <TextBlock Text=":" Foreground="#71717A" FontSize="12"/>
                            <TextBox Text="{Binding PiMatrixApiPort, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" Foreground="#E4E4E7" BorderThickness="0"
                                     FontWeight="SemiBold" FontSize="12" Width="40"/>
                            <Button Content="Connect" Command="{Binding ConnectPiMatrixCommand}"
                                    Background="#3F3F46" Foreground="#E4E4E7" BorderThickness="0"
                                    Margin="8,0,0,0" Padding="6,2" FontSize="11" Cursor="Hand"/>
                        </StackPanel>
                    </Border>

                    <!-- PiMatrix Status Pill -->
                    <Border CornerRadius="6" Padding="10,6" Background="#27272A">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center"
                                     Fill="{Binding PiMatrixStatus.IsConnected, Converter={StaticResource BoolToColorConverter}}"/>
                            <TextBlock Text="{Binding PiMatrixStatus.Mode, StringFormat='PiMatrix ({0})'}"
                                       FontSize="11" FontWeight="SemiBold" Foreground="#E4E4E7"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Global Action Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Pop Out Small Preview -->
                    <Button Content="🗗 Pop Out Preview Deck" Command="{Binding OpenPreviewWindowCommand}"
                            Background="#3B82F6" Foreground="White" BorderThickness="0"
                            Padding="12,7" FontWeight="SemiBold" FontSize="12" Margin="0,0,8,0" Cursor="Hand"/>

                    <!-- Start All Streams -->
                    <Button Content="▶ Start All" Command="{Binding StartAllStreamsCommand}"
                            Background="#10B981" Foreground="White" BorderThickness="0"
                            Padding="10,7" FontWeight="SemiBold" FontSize="12" Margin="0,0,6,0" Cursor="Hand"/>

                    <!-- Stop All Streams -->
                    <Button Content="⏹ Stop All" Command="{Binding StopAllStreamsCommand}"
                            Background="#EF4444" Foreground="White" BorderThickness="0"
                            Padding="10,7" FontWeight="SemiBold" FontSize="12" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN WORKSPACE -->
        <Grid Grid.Row="1" Margin="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: MONITOR SELECTOR CARDS -->
            <Border Grid.Column="0" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="8" Margin="0,0,14,0" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Virtual Monitors (1–4)" FontWeight="Bold" FontSize="13" Foreground="#E4E4E7" Margin="4,0,0,10"/>

                    <ListBox Grid.Row="1" ItemsSource="{Binding Monitors}"
                             SelectedItem="{Binding SelectedMonitor}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:MonitorViewModel}">
                                <Border Background="#27272A" CornerRadius="6" Margin="0,4" Padding="10"
                                        BorderBrush="{Binding TallyBrush}" BorderThickness="1.5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Mini Preview Thumbnail -->
                                        <Border Grid.Column="0" Width="80" Height="50" Background="#09090B" CornerRadius="4" Margin="0,0,10,0">
                                            <Image Source="{Binding PreviewImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="LowQuality"/>
                                        </Border>

                                        <!-- Monitor Info -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" Foreground="#FAFAFA"/>
                                                <CheckBox Grid.Column="1" IsChecked="{Binding IsEnabled}" Content="Enabled" FontSize="11" Foreground="#A1A1AA"/>
                                            </Grid>

                                            <TextBlock Text="{Binding ResolutionSummary}" FontSize="10.5" Foreground="#A1A1AA" Margin="0,2,0,0"/>

                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <Border Background="#3F3F46" CornerRadius="3" Padding="4,1" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding Protocol}" FontSize="9.5" FontWeight="Bold" Foreground="#38BDF8"/>
                                                </Border>
                                                <TextBlock Text="{Binding StatusText}" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{Binding TallyBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding CurrentFps, StringFormat='{} • {0:0} fps'}" FontSize="10"
                                                           Foreground="#10B981" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- RIGHT: MONITOR INSPECTOR & CONFIG -->
            <Border Grid.Column="1" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="8" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel DataContext="{Binding SelectedMonitor}">
                        <!-- Monitor Header & Live Action -->
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="18" FontWeight="Bold" Background="Transparent"
                                             Foreground="#FAFAFA" BorderThickness="0" Margin="0,0,8,0"/>
                                    <Border Background="#27272A" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding AspectRatio, StringFormat='{}Aspect Ratio: {0}'}"
                                                   FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Configure display dimensions, encoding quality, and network streaming route."
                                           FontSize="12" Foreground="#71717A" Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- Big Start/Stop Button -->
                            <Button Grid.Column="1" Command="{Binding ToggleStreamingCommand}"
                                    Width="160" Height="42" BorderThickness="0"
                                    Cursor="Hand" FontWeight="Bold" FontSize="13" Foreground="White"
                                    Background="{Binding IsStreaming, Converter={StaticResource StreamButtonColorConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding IsStreaming, Converter={StaticResource StreamButtonTextConverter}}"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Separator Background="#27272A" Margin="0,0,0,18"/>

                        <!-- Resolution & Aspect Ratio Section -->
                        <TextBlock Text="DISPLAY RESOLUTION &amp; ASPECT RATIO" FontWeight="Bold" FontSize="11" Foreground="#A1A1AA" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Resolution Preset Dropdown -->
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="Standard Preset" FontSize="11" Foreground="#71717A" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding AvailablePresets}"
                                          SelectedItem="{Binding SelectedResolution}"
                                          Background="#27272A" Foreground="#FAFAFA" Height="32"/>
                            </StackPanel>

                            <!-- Custom Width -->
                            <StackPanel Grid.Column="1" Width="90" Margin="0,0,10,0">
                                <TextBlock Text="Width (px)" FontSize="11" Foreground="#71717A" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding Width, UpdateSourceTrigger=PropertyChanged}"
                                         Background="#27272A" Foreground="#FAFAFA" BorderBrush="#3F3F46"
                                         Height="32" Padding="6" FontWeight="SemiBold" VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <!-- Custom Height -->
                            <StackPanel Grid.Column="2" Width="90" Margin="0,0,10,0">
                                <TextBlock Text="Height (px)" FontSize="11" Foreground="#71717A" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding Height, UpdateSourceTrigger=PropertyChanged}"
                                         Background="#27272A" Foreground="#FAFAFA" BorderBrush="#3F3F46"
                                         Height="32" Padding="6" FontWeight="SemiBold" VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <!-- Refresh Rate -->
                            <StackPanel Grid.Column="3" Width="90">
                                <TextBlock Text="Refresh (Hz)" FontSize="11" Foreground="#71717A" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding RefreshRate, UpdateSourceTrigger=PropertyChanged}"
                                         Background="#27272A" Foreground="#FAFAFA" BorderBrush="#3F3F46"
                                         Height="32" Padding="6" FontWeight="SemiBold" VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <Separator Background="#27272A" Margin="0,0,0,18"/>

                        <!-- Streaming Protocol & Network Target -->
                        <TextBlock Text="STREAMING TARGET &amp; PROTOCOL" FontWeight="Bold" FontSize="11" Foreground="#A1A1AA" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="160"/>
                            </Grid.ColumnDefinitions>

                            <!-- Protocol Selector -->
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Protocol" FontSize="11" Foreground="#71717A" Margin="0,0,0,4"/>
                                <ComboBox SelectedItem="{Binding Protocol}"
                                          ItemsSource="{Binding Source={StaticResource ProtocolEnumValues}}"
                                          Background="#27272A" Foreground="#FAFAFA" Height="32"/>
                            </StackPanel>

                            <!-- Target Host -->
                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                <TextBlock Text="Target Host / IP" FontSize="11" Foreground="#71717A" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding StreamHost, UpdateSourceTrigger=PropertyChanged}"
                                         Background="#27272A" Foreground="#FAFAFA" BorderBrush="#3F3F46"
                                         Height="32" Padding="6" VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <!-- Port -->
                            <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                <TextBlock Text="Port" FontSize="11" Foreground="#71717A" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding StreamPort, UpdateSourceTrigger=PropertyChanged}"
                                         Background="#27272A" Foreground="#FAFAFA" BorderBrush="#3F3F46"
                                         Height="32" Padding="6" VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <!-- Stream Path / ID -->
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="Stream Path / ID" FontSize="11" Foreground="#71717A" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding StreamPath, UpdateSourceTrigger=PropertyChanged}"
                                         Background="#27272A" Foreground="#FAFAFA" BorderBrush="#3F3F46"
                                         Height="32" Padding="6" VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- Generated Stream URL -->
                        <Border Background="#09090B" CornerRadius="6" Padding="10,6" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Active Stream URL: " Foreground="#71717A" FontSize="11" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding StreamUrl, Mode=OneWay}" IsReadOnly="True"
                                         Background="Transparent" Foreground="#10B981" BorderThickness="0"
                                         FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Separator Background="#27272A" Margin="0,0,0,18"/>

                        <!-- Encoding & Quality -->
                        <TextBlock Text="ENCODER &amp; LATENCY OPTIMIZATION" FontWeight="Bold" FontSize="11" Foreground="#A1A1AA" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="Video Encoder" FontSize="11" Foreground="#71717A" Margin="0,0,0,4"/>
                                <ComboBox SelectedItem="{Binding Encoder}"
                                          ItemsSource="{Binding Source={StaticResource EncoderEnumValues}}"
                                          Background="#27272A" Foreground="#FAFAFA" Height="32"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Bitrate (Kbps)" FontSize="11" Foreground="#71717A" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding BitrateKbps, UpdateSourceTrigger=PropertyChanged}"
                                         Background="#27272A" Foreground="#FAFAFA" BorderBrush="#3F3F46"
                                         Height="32" Padding="6" VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- BOTTOM STATUS BAR & DRIVER CONTROLS -->
        <Border Grid.Row="2" Background="#18181B" BorderBrush="#27272A" BorderThickness="0,1,0,0" Padding="18,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Driver Status Message -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Margin="0,0,8,0"
                             Fill="{Binding IsDriverInstalled, Converter={StaticResource BoolToColorConverter}}"/>
                    <TextBlock Text="{Binding DriverStatusMessage}" FontSize="11.5" Foreground="#A1A1AA"/>
                </StackPanel>

                <!-- Driver Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Apply to Driver" Command="{Binding ApplyDriverConfigCommand}"
                            Background="#3F3F46" Foreground="#FAFAFA" BorderThickness="0"
                            Padding="10,4" FontSize="11" Margin="0,0,6,0" Cursor="Hand"/>

                    <Button Content="Restart Adapter" Command="{Binding RestartDriverCommand}"
                            Background="#3F3F46" Foreground="#FAFAFA" BorderThickness="0"
                            Padding="10,4" FontSize="11" Margin="0,0,6,0" Cursor="Hand"/>

                    <Button Content="Refresh Status" Command="{Binding RefreshDriverStatusCommand}"
                            Background="#27272A" Foreground="#A1A1AA" BorderThickness="0"
                            Padding="8,4" FontSize="11" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
