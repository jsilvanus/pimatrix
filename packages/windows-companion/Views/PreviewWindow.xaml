<Window x:Class="PiMatrixCompanion.Views.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PiMatrixCompanion.ViewModels"
        mc:Ignorable="d"
        Title="PiMatrix Virtual Displays — Live Preview"
        Height="360" Width="640"
        MinHeight="200" MinWidth="320"
        Background="#18181B"
        Foreground="#F4F4F5"
        Topmost="{Binding IsAlwaysOnTop}"
        Opacity="{Binding Opacity}"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32"
                      CornerRadius="8"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="6" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="8" Background="#18181B">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title Bar / Controls -->
            <Grid Grid.Row="0" Background="#27272A">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Ellipse Width="10" Height="10" Fill="#10B981" Margin="0,0,8,0"/>
                    <TextBlock Text="PiMatrix Preview Deck" FontWeight="SemiBold" FontSize="12" Foreground="#E4E4E7"/>
                </StackPanel>

                <!-- Window action buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,6,0">
                    <!-- Layout Cycle Button -->
                    <Button Content="Layout" Command="{Binding CycleLayoutCommand}"
                            Background="#3F3F46" Foreground="#E4E4E7" BorderThickness="0"
                            Padding="8,3" Margin="2,0" FontSize="11" Cursor="Hand"/>

                    <!-- Always on top toggle -->
                    <ToggleButton IsChecked="{Binding IsAlwaysOnTop, Mode=TwoWay}"
                                  Content="{Binding AlwaysOnTopStatusText}"
                                  ToolTip="Click to toggle Always On Top on or off"
                                  Background="#3F3F46" Foreground="#E4E4E7" BorderThickness="0"
                                  Padding="8,3" Margin="2,0" FontSize="11" Cursor="Hand"/>

                    <!-- Close button -->
                    <Button Content="✕" Click="CloseButton_Click"
                            Background="Transparent" Foreground="#A1A1AA" BorderThickness="0"
                            Width="28" Height="24" FontSize="12" Cursor="Hand"/>
                </StackPanel>
            </Grid>

            <!-- Video Preview Grid -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Monitors}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="{Binding DataContext.Columns, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:MonitorViewModel}">
                            <Border Margin="6" Background="#09090B" CornerRadius="6"
                                    BorderBrush="{Binding TallyBrush}" BorderThickness="2"
                                    Visibility="{Binding IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid>
                                    <!-- Video Image surface -->
                                    <Image Source="{Binding PreviewImage}"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="LowQuality"/>

                                    <!-- Placeholder when no frame -->
                                    <Border Background="#18181B" HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Padding="12" CornerRadius="4"
                                            Visibility="{Binding PreviewImage, Converter={StaticResource NullToVisibilityConverter}}">
                                        <TextBlock Text="Waiting for display signal..." Foreground="#71717A" FontSize="11"/>
                                    </Border>

                                    <!-- Top HUD Overlay: Title & Aspect Ratio -->
                                    <Border VerticalAlignment="Top" Background="#B0000000" Padding="6,3" CornerRadius="4,4,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="8" Height="8" Fill="{Binding TallyBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="11" Foreground="#FAFAFA"/>
                                                <TextBlock Text=" • " Foreground="#71717A" FontSize="11"/>
                                                <TextBlock Text="{Binding AspectRatio}" Foreground="#A1A1AA" FontSize="11"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Protocol}" FontWeight="SemiBold"
                                                       Foreground="#38BDF8" FontSize="10" Margin="4,0,0,0"/>
                                        </Grid>
                                    </Border>

                                    <!-- Bottom HUD Overlay: Stats (FPS, Bitrate, Resolution) -->
                                    <Border VerticalAlignment="Bottom" Background="#B0000000" Padding="6,2" CornerRadius="0,0,4,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding ResolutionSummary}" FontSize="10" Foreground="#A1A1AA"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <TextBlock Text="{Binding CurrentFps, StringFormat='{}{0:0} fps'}" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="#10B981" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding CurrentBitrateKbps, StringFormat='{}{0:0} kbps'}" FontSize="10"
                                                           Foreground="#F59E0B"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
