# PiMatrix Canva App Plugin — Build Configuration Template
# Copy this file to .env or .env.local to customize build-time settings for your church/organization.

# Plugin & Organization Branding
VITE_PLUGIN_NAME="PiMatrix Canva App"
VITE_ORG_NAME="Riihimäen Keskuskirkko"

# Network Host Addresses
# 1. In-the-same LAN Address (Sanctuary Wi-Fi / Local Network)
VITE_LAN_URL="http://192.168.1.100:3000"

# 2. Internet / WAN Router Address (Remote access from home/outside church)
# Tip: Forward a custom external port in your router (e.g. port 8443 or 3000) directly to PiMatrix.
VITE_WAN_URL="http://yourchurch.dyndns.org:3000"

# Initial Default Profile ("lan" or "wan")
VITE_DEFAULT_PROFILE="lan"

# Team-Only Security Token
# Protects the Canva control and push endpoints against unauthorized Internet access.
# Must match PIMATRIX_CANVA_SECRET_TOKEN on the PiMatrix backend server.
VITE_CANVA_SECRET_TOKEN="keskuskirkko-canva-secret-2026"
