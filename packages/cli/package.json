{
  "name": "@pimatrix/cli",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "bin": {
    "pimatrix": "./dist/main.js"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "bundle": "esbuild src/main.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/pimatrix-bundled.cjs",
    "sea:prep": "npm run bundle && node --experimental-sea-config sea-config.json",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@pimatrix/api-client": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6",
    "tsx": "^4.19.0",
    "typescript": "^5.7.3"
  }
}
